# Firebase web app configuration (Firebase console → Project settings → Your apps).
# Copy to .env.local and fill in. These are public client identifiers, not secrets;
# data security is enforced by firestore.rules and storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
