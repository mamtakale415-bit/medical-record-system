rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isDoctor() { return signedIn() && role() == 'doctor'; }
    function isAssignedDoctor(patientId) {
      return isDoctor() &&
        request.auth.uid in get(/databases/$(database)/documents/patients/$(patientId)).data.assignedDoctorIds;
    }
    function canAccessPatient(patientId) {
      return signedIn() && (request.auth.uid == patientId || isAssignedDoctor(patientId) || isAdmin());
    }

    // Self-registration may only create a patient profile; role changes are admin-only.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isDoctor());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'patient';
      allow update: if isAdmin() ||
        (request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /patients/{patientId} {
      allow read: if canAccessPatient(patientId);
      allow create: if signedIn() && request.auth.uid == patientId;
      allow update: if isAdmin() ||
        (request.auth.uid == patientId &&
          request.resource.data.assignedDoctorIds == resource.data.assignedDoctorIds);

      match /readings/{readingId} {
        allow read: if canAccessPatient(patientId);
        allow create: if (request.auth.uid == patientId || isAssignedDoctor(patientId)) &&
          request.resource.data.source in ['manual', 'device'];
        allow update, delete: if isAdmin();
      }

      match /records/{recordId} {
        allow read: if canAccessPatient(patientId);
        allow write: if isAssignedDoctor(patientId) || isAdmin();
      }

      match /prescriptions/{prescriptionId} {
        allow read: if canAccessPatient(patientId);
        allow write: if isAssignedDoctor(patientId);
      }

      match /reports/{reportId} {
        allow read: if canAccessPatient(patientId);
        allow create: if (request.auth.uid == patientId || isAssignedDoctor(patientId)) &&
          request.resource.data.uploadedBy == request.auth.uid;
        allow delete: if isAdmin();
      }

      match /settings/{docId} {
        allow read: if canAccessPatient(patientId);
        allow write: if isAssignedDoctor(patientId) || isAdmin();
      }
    }

    match /appointments/{id} {
      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid &&
        request.resource.data.status == 'requested';
      allow update: if signedIn() &&
        (resource.data.doctorId == request.auth.uid || resource.data.patientId == request.auth.uid || isAdmin());
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isDoctor() || isAdmin();
    }

    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid;
    }
  }
}
